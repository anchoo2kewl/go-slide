{{define "present.gohtml"}}<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=2.0, user-scalable=yes" />
  <title>{{.Slide.Title}}</title>
  {{if .Slide.Description}}<meta name="description" content="{{.Slide.Description}}" />{{end}}
  {{if .Slide.AuthorName}}<meta name="author" content="{{.Slide.AuthorName}}" />{{end}}
  {{if .Slide.CanonicalURL}}<link rel="canonical" href="{{.Slide.CanonicalURL}}" />{{end}}

  {{.FontTags}}

  <link rel="stylesheet" href="{{.RevealCDN}}/dist/reveal.css">
  <link rel="stylesheet" href="{{.RevealCDN}}/dist/theme/white.css" id="theme">
  <link rel="stylesheet" href="{{.RevealCDN}}/plugin/highlight/monokai.css">

  <!-- Conditionally load the print stylesheet only when ?print-pdf is in the URL. -->
  <script>
    (function () {
      var pdf = /print-pdf/i.test(window.location.search);
      var link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = '{{.RevealCDN}}/css/print/' + (pdf ? 'pdf.css' : 'paper.css');
      document.head.appendChild(link);
    })();
  </script>

  <style>
    :root {
      --r-main-font-size: 30px;
      --r-block-margin: 16px;
      --r-heading-font: Inter, "Segoe UI", Arial, sans-serif;
      --r-code-font: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
      --r-heading1-size: 2.0em;
      --r-heading2-size: 1.6em;
      --r-heading3-size: 1.35em;
    }
    html, body { width: 100% !important; height: 100% !important; margin: 0 !important; padding: 0 !important; overflow: hidden !important; }
    .reveal h1, .reveal h2, .reveal h3, .reveal h4, .reveal h5, .reveal h6 { text-transform: none; line-height: 1.08; letter-spacing: -0.01em; }
    .reveal .slides { text-align: left; }
    .reveal .slides section { max-width: 1100px; margin: 0 auto; padding: 60px 40px 40px 40px; overflow-y: auto; overflow-x: hidden; box-sizing: border-box; }
    .reveal .slides section.pptx-slide { padding: 0 !important; max-width: 100% !important; width: 100% !important; height: 100% !important; overflow: hidden !important; }
    .reveal .controls, .reveal .progress { color: var(--slide-accent, #2563eb); }
    .reveal a { color: var(--slide-accent, #2563eb); }
    .reveal a:hover { filter: brightness(1.15); }

    /* Theme-provided slide-content styles (single source of truth) */
    {{.ThemeCSS}}

    /* Nav (Edit / Back / PDF / Fullscreen) */
    .presentation-nav { position: fixed; top: 20px; right: 20px; z-index: 100; display: flex; gap: 10px; align-items: center; }
    .nav-btn { background: rgba(255,255,255,0.9); border: 1px solid #e5e7eb; border-radius: 8px; padding: 8px 12px; font-size: 14px; font-weight: 500; text-decoration: none; color: #374151; transition: all .2s; display: flex; align-items: center; gap: 4px; }
    .nav-btn:hover { background: #fff; box-shadow: 0 4px 6px -1px rgba(0,0,0,.1); color: #2563eb; }
    .nav-btn svg { width: 16px; height: 16px; }

    .nav-author { display: flex; align-items: center; gap: 6px; margin-right: 6px; }
    .nav-author-pill { display: flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.9); border: 1px solid #e5e7eb; border-radius: 999px; padding: 3px 10px 3px 3px; font-size: 13px; font-weight: 500; color: #374151; text-decoration: none; transition: all .2s; }
    .nav-author-pill:hover { background: #fff; box-shadow: 0 2px 4px rgba(0,0,0,.08); color: #2563eb; }
    .nav-author-pill img { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
    .nav-author-pill .nav-author-initial { width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: #e2e8f0; color: #475569; font-size: 11px; font-weight: 700; }
    .nav-author-name { white-space: nowrap; max-width: 140px; overflow: hidden; text-overflow: ellipsis; }
    .nav-author-sep { color: #9ca3af; font-weight: 700; }

    @media (prefers-color-scheme: dark) {
      .nav-btn, .nav-author-pill { background: rgba(30,41,59,0.9); border-color: #475569; color: #e2e8f0; }
      .nav-btn:hover, .nav-author-pill:hover { background: rgba(30,41,59,1); color: #60a5fa; }
      .nav-author-pill .nav-author-initial { background: #475569; color: #cbd5e1; }
      .nav-author-sep { color: #64748b; }
    }
    @media (max-width: 700px) { .nav-author-name { display: none; } .nav-author-pill { padding: 3px; } }
    @media print, html.print-pdf-mode { .presentation-nav { display: none !important; } }
    html.print-pdf-mode .presentation-nav { display: none !important; }
  </style>
</head>
<body>
  <div class="presentation-nav">
    {{if .Slide.AuthorName}}
    <div class="nav-author" title="By {{.Slide.AuthorName}}{{range .Slide.Coauthors}} with {{.Name}}{{end}}">
      <a href="/users/{{.Slide.AuthorUsername}}" class="nav-author-pill" title="{{.Slide.AuthorName}} (author)">
        {{if .Slide.AuthorAvatarURL}}<img src="{{.Slide.AuthorAvatarURL}}" alt="{{.Slide.AuthorName}}" width="24" height="24">{{else}}<span class="nav-author-initial">{{slice .Slide.AuthorUsername 0 1}}</span>{{end}}
        <span class="nav-author-name">{{.Slide.AuthorName}}</span>
      </a>
      {{range .Slide.Coauthors}}
      <span class="nav-author-sep">·</span>
      <a href="/users/{{.Username}}" class="nav-author-pill" title="{{.Name}} (co-author)">
        {{if .AvatarURL}}<img src="{{.AvatarURL}}" alt="{{.Name}}" width="24" height="24">{{else}}<span class="nav-author-initial">{{slice .Username 0 1}}</span>{{end}}
        <span class="nav-author-name">{{.Name}}</span>
      </a>
      {{end}}
    </div>
    {{end}}
    {{if .Slide.EditURL}}
    <a href="{{.Slide.EditURL}}" class="nav-btn" title="Edit Slide">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Edit
    </a>
    {{end}}
    <a href="{{if .Slide.BackURL}}{{.Slide.BackURL}}{{else}}/slides{{end}}" class="nav-btn" title="Back">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      Back
    </a>
    <a href="?print-pdf" target="_blank" rel="noopener" class="nav-btn" title="Download PDF" id="download-pdf-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      PDF
    </a>
    <button id="fullscreen-btn" class="nav-btn" title="Toggle Fullscreen">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
      Fullscreen
    </button>
  </div>

  <div class="reveal">
    <div class="slides">
      {{.Slide.ContentHTML}}
    </div>
  </div>

  <script src="{{.RevealCDN}}/dist/reveal.js"></script>
  <script src="{{.RevealCDN}}/plugin/notes/notes.js"></script>
  <script src="{{.RevealCDN}}/plugin/highlight/highlight.js"></script>
  <script>
    var isPrintPdf = /print-pdf/i.test(window.location.search);
    if (isPrintPdf) document.documentElement.classList.add('print-pdf-mode');

    Reveal.initialize({
      width: 1280, height: 800, margin: isPrintPdf ? 0.04 : 0.08,
      minScale: isPrintPdf ? 1 : 0.2,
      maxScale: isPrintPdf ? 1 : 1.5,
      hash: !isPrintPdf,
      controls: !isPrintPdf,
      progress: !isPrintPdf,
      slideNumber: !isPrintPdf,
      center: false,
      transition: isPrintPdf ? 'none' : 'fade',
      pdfSeparateFragments: false,
      pdfMaxPagesPerSlide: 1,
      plugins: [ RevealNotes, RevealHighlight ],
    });

    if (isPrintPdf) {
      Reveal.on('pdf-ready', function () { setTimeout(function () { window.print(); }, 250); });
      window.addEventListener('load', function () {
        setTimeout(function () { if (!window.__printed) { window.__printed = true; window.print(); } }, 1500);
      });
    }

    document.getElementById('fullscreen-btn').addEventListener('click', function () {
      var el = document.documentElement;
      var isFs = document.fullscreenElement || document.webkitFullscreenElement;
      if (isFs) (document.exitFullscreen || document.webkitExitFullscreen).call(document);
      else (el.requestFullscreen || el.webkitRequestFullscreen).call(el);
    });
  </script>
</body>
</html>
{{end}}
